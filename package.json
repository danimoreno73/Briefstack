{
  "name": "briefstack",
  "version": "0.1.0",
  "description": "Turn an idea into a ready-to-use Claude project, and learn from each one.",
  "private": true,
  "type": "module",
  "bin": {
    "briefstack": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "library",
    "schemas",
    "scripts"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "eslint .",
    "briefstack": "tsx src/cli.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  }
}
