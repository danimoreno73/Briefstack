{
  "name": "briefstack",
  "version": "1.0.0",
  "description": "A local tool that turns an idea into a ready-to-use Claude project by running your own Claude Code, and learns from each one.",
  "license": "MIT",
  "author": "danimoreno73",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danimoreno73/Briefstack.git"
  },
  "homepage": "https://github.com/danimoreno73/Briefstack#readme",
  "bugs": {
    "url": "https://github.com/danimoreno73/Briefstack/issues"
  },
  "keywords": [
    "claude",
    "claude-code",
    "agents",
    "project-generator",
    "cli"
  ],
  "private": true,
  "type": "module",
  "bin": {
    "briefstack": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "library",
    "schemas",
    "scripts"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "npm run build:app",
    "build:app": "tsc -p tsconfig.build.json && npm run build:ui",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.build.json && tsc -p tsconfig.ui.json && tsc -p tests/e2e/tsconfig.json && node scripts/copy-ui-static.mjs",
    "test": "vitest run",
    "lint": "eslint .",
    "briefstack": "tsx src/cli.ts",
    "schema": "tsx scripts/generate-schema.ts",
    "build:ui": "tsc -p tsconfig.ui.json && node scripts/copy-ui-static.mjs",
    "test:e2e": "npm run build:ui && playwright test",
    "screenshots": "npm run build:ui && playwright test -c playwright.screenshots.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.61.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.286",
    "markdown-it": "15.0.1",
    "preact": "^10.29.8",
    "yaml": "^2.9.1",
    "zod": "^4.6.6"
  }
}
