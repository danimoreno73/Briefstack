{
  "worktree": {
    "baseRef": "head"
  },
  "permissions": {
    "allow": [
      "Bash(npm run --silent briefstack *)",
      "PowerShell(npm run --silent briefstack *)"
    ],
    "deny": [
      "Bash(sed *-i*)",
      "Bash(perl *-i*)",
      "Bash(tee *)",
      "Bash(node -e *)",
      "Bash(node --eval *)",
      "Bash(python -c *)",
      "Bash(python3 -c *)",
      "Bash(py -c *)",
      "PowerShell(Set-Content *)",
      "PowerShell(Add-Content *)",
      "PowerShell(Out-File *)",
      "PowerShell(Tee-Object *)",
      "PowerShell(New-Item * -Value *)",
      "PowerShell(* >*)"
    ]
  },
  "hooks": {
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/hook-event.mjs"
            ]
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/hook-event.mjs"
            ]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/hook-event.mjs"
            ]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/hook-event.mjs"
            ]
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/hook-event.mjs"
            ]
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/hook-event.mjs"
            ]
          }
        ]
      }
    ]
  }
}
